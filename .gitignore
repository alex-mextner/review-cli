.DS_Store
__pycache__/
*.pyc
.pytest_cache/

.worktrees/

# Python package build artifacts (review-cli is now a real package — `pip`/pipx build
# produces these from pyproject.toml; never commit them).
build/
dist/
*.egg-info/

# uv writes a lockfile when the suite is run via `uv run` (the CI / dev path is
# pip + `.[test]`, not uv), so the lock is a local artifact — never commit it.
uv.lock

# Per-machine Claude Code harness overrides (the committed shared slot is settings.json).
.claude/settings.local.json

# Local visual-QA scratch: dashboard tab screenshots are captured for live verification,
# not committed (binary bloat; the dashboard is verified by running it, not stored PNGs).
# Anchored to the repo root so it never hides an intentional nested screenshots/ asset dir.
/screenshots/

# Live tier-2 bot credentials (never commit)
.env.live
